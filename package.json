{
  "name": "nexus",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @nexus/api --filter @nexus/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,css}\" && pnpm --filter @nexus/api exec prisma format",
    "prisma:generate": "pnpm --filter @nexus/api prisma:generate",
    "prisma:migrate": "pnpm --filter @nexus/api prisma:migrate",
    "prisma:seed": "pnpm --filter @nexus/api prisma:seed"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  COMPANY
  FREELANCER
}

enum CompanyMemberRole {
  OWNER
  ADMIN
  FINANCE
  OPERATOR
  VIEWER
}

enum AdminAccessLevel {
  OWNER
  MANAGER
  FINANCE
  SUPPORT
  VERIFICATION
  READONLY
}

enum CompanyInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum EventStatus {
  DRAFT
  OPEN
  INVITING
  CONFIRMED
  IN_PROGRESS
  FINISHED
  CANCELLED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum ContractStatus {
  PENDING_PAYMENT
  CONFIRMED
  COMPLETED
  NO_SHOW
  CANCELLED
  DISPUTED
  PAID
}

enum PaymentStatus {
  PENDING
  WAITING_PAYMENT
  AUTHORIZED
  PAID
  FAILED
  CANCELLED
  REFUNDED
  CHARGEBACK
  DISPUTED
  RELEASED
}

enum PaymentSplitStatus {
  PENDING
  RESERVED
  WAITING_RELEASE
  RELEASED
  PAID
  FAILED
  BLOCKED
  REFUNDED
}

enum PayoutStatus {
  PENDING
  SCHEDULED
  PROCESSING
  PAID
  FAILED
  CANCELLED
}

enum GatewayProvider {
  SIMULATED
  ASAAS
  PAGARME
  IUGU
}

enum GatewayAccountStatus {
  PENDING
  UNDER_REVIEW
  ACTIVE
  REJECTED
  BLOCKED
  ERROR
}

enum GatewayKycStatus {
  NOT_STARTED
  PENDING
  APPROVED
  REJECTED
  REQUIRED_MORE_INFO
}

enum TransactionType {
  CREDIT
  DEBIT
  FEE
  PAYOUT
  REFUND
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

model User {
  id                    String                      @id @default(cuid())
  name                  String
  email                 String                      @unique
  passwordHash          String
  role                  UserRole
  phone                 String?
  refreshTokenHash      String?
  resetTokenHash        String?
  resetTokenExpiresAt   DateTime?
  isActive              Boolean                     @default(true)
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  companyProfile        CompanyProfile?
  companyMemberships    CompanyMember[]
  companyInvitations    CompanyInvitation[]         @relation("CompanyInvitationInviter")
  adminProfile          AdminProfile?
  createdAdminProfiles  AdminProfile[]              @relation("AdminProfileCreator")
  companyFavorites      CompanyFavoriteFreelancer[]
  freelancerProfile     FreelancerProfile?
  gatewayAccounts       GatewayAccount[]
  verificationDocuments VerificationDocument[]
  notifications         Notification[]
  chatMessages          ChatMessage[]
  auditLogs             AuditLog[]
}

model AdminProfile {
  id          String           @id @default(cuid())
  userId      String           @unique
  accessLevel AdminAccessLevel @default(READONLY)
  createdById String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdBy   User?            @relation("AdminProfileCreator", fields: [createdById], references: [id])

  @@index([accessLevel])
  @@index([createdById])
}

model CompanyProfile {
  id                    String                      @id @default(cuid())
  userId                String                      @unique
  user                  User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName           String
  document              String?
  responsibleName       String
  phone                 String?
  email                 String
  logoUrl               String?
  postalCode            String?
  addressStreet         String?
  addressNumber         String?
  addressComplement     String?
  neighborhood          String?
  city                  String?
  state                 String?
  verificationStatus    VerificationStatus          @default(PENDING)
  ratingAverage         Decimal                     @default(0) @db.Decimal(3, 2)
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  events                Event[]
  invitations           Invitation[]
  applications          Application[]
  contracts             Contract[]
  chatThreads           ChatThread[]
  wallet                Wallet?
  payments              Payment[]
  gatewayAccounts       GatewayAccount[]
  members               CompanyMember[]
  teamInvitations       CompanyInvitation[]
  favoriteFreelancers   CompanyFavoriteFreelancer[]
  verificationDocuments VerificationDocument[]
  reviewsGiven          Review[]                    @relation("CompanyReviewsGiven")
  reviewsReceived       Review[]                    @relation("CompanyReviewsReceived")
}

model CompanyMember {
  id        String            @id @default(cuid())
  companyId String
  userId    String
  role      CompanyMemberRole @default(VIEWER)
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  company   CompanyProfile    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([userId])
  @@index([companyId])
}

model CompanyInvitation {
  id          String                  @id @default(cuid())
  companyId   String
  email       String
  role        CompanyMemberRole       @default(VIEWER)
  tokenHash   String
  status      CompanyInvitationStatus @default(PENDING)
  expiresAt   DateTime
  acceptedAt  DateTime?
  invitedById String?
  createdAt   DateTime                @default(now())
  company     CompanyProfile          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invitedBy   User?                   @relation("CompanyInvitationInviter", fields: [invitedById], references: [id])

  @@index([companyId])
  @@index([email])
  @@index([tokenHash])
}

model FreelancerProfile {
  id                    String                      @id @default(cuid())
  userId                String                      @unique
  user                  User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName              String?
  cpf                   String?
  identityDocument      String?
  displayName           String?
  avatarUrl             String?
  postalCode            String?
  addressStreet         String?
  addressNumber         String?
  addressComplement     String?
  neighborhood          String?
  city                  String?
  state                 String?
  tools                 String?
  transportation        String?
  dailyRateCents        Int?
  professionalSummary   String?
  experienceYears       Int?
  eventTypes            String?
  certifications        String?
  portfolioUrl          String?
  travelAvailability    String?
  bankData              Json?
  verificationStatus    VerificationStatus          @default(PENDING)
  ratingAverage         Decimal                     @default(0) @db.Decimal(3, 2)
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  skills                FreelancerSkill[]
  invitations           Invitation[]
  applications          Application[]
  contracts             Contract[]
  paymentSplits         PaymentSplit[]
  payouts               Payout[]
  chatThreads           ChatThread[]
  availability          Availability[]
  wallet                Wallet?
  gatewayAccounts       GatewayAccount[]
  favoriteCompanies     CompanyFavoriteFreelancer[]
  verificationDocuments VerificationDocument[]
  reviewsGiven          Review[]                    @relation("FreelancerReviewsGiven")
  reviewsReceived       Review[]                    @relation("FreelancerReviewsReceived")
}

model CompanyFavoriteFreelancer {
  id           String            @id @default(cuid())
  companyId    String
  freelancerId String
  createdById  String
  createdAt    DateTime          @default(now())
  company      CompanyProfile    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  freelancer   FreelancerProfile @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  createdBy    User              @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@unique([companyId, freelancerId])
  @@index([companyId])
  @@index([freelancerId])
  @@index([createdById])
}

model VerificationDocument {
  id           String             @id @default(cuid())
  companyId    String?
  freelancerId String?
  uploadedById String
  category     String
  originalName String
  fileName     String
  mimeType     String
  sizeBytes    Int
  storagePath  String
  createdAt    DateTime           @default(now())
  company      CompanyProfile?    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  freelancer   FreelancerProfile? @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  uploadedBy   User               @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([freelancerId])
  @@index([uploadedById])
}

model Skill {
  id           String             @id @default(cuid())
  name         String             @unique
  slug         String             @unique
  description  String?
  isActive     Boolean            @default(true)
  createdAt    DateTime           @default(now())
  freelancers  FreelancerSkill[]
  requirements EventRequirement[]
}

model FreelancerSkill {
  freelancerId      String
  skillId           String
  dailyRateCents    Int?
  knowledgeLevel    String?
  experienceSummary String?
  equipment         String?
  courses           String?
  abilities         Json?
  createdAt         DateTime          @default(now())
  freelancer        FreelancerProfile @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  skill             Skill             @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([freelancerId, skillId])
}

model Event {
  id                   String             @id @default(cuid())
  companyId            String
  company              CompanyProfile     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name                 String
  startsAt             DateTime
  endsAt               DateTime
  location             String
  city                 String?
  state                String?
  description          String?
  eventType            String?
  desiredProfessionals Int                @default(1)
  status               EventStatus        @default(DRAFT)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  requirements         EventRequirement[]
  invitations          Invitation[]
  applications         Application[]
  contracts            Contract[]
  payments             Payment[]
  chatThreads          ChatThread[]
}

model EventRequirement {
  id             String        @id @default(cuid())
  eventId        String
  skillId        String
  quantity       Int           @default(1)
  dailyRateCents Int?
  event          Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  skill          Skill         @relation(fields: [skillId], references: [id])
  invitations    Invitation[]
  applications   Application[]
}

model Invitation {
  id                  String            @id @default(cuid())
  eventId             String
  companyId           String
  freelancerId        String
  eventRequirementId  String?
  status              InvitationStatus  @default(PENDING)
  message             String?
  proposedAmountCents Int?
  counterAmountCents  Int?
  agreedAmountCents   Int?
  expiresAt           DateTime
  respondedAt         DateTime?
  createdAt           DateTime          @default(now())
  event               Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventRequirement    EventRequirement? @relation(fields: [eventRequirementId], references: [id], onDelete: SetNull)
  company             CompanyProfile    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  freelancer          FreelancerProfile @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  contract            Contract?
  chatThread          ChatThread?

  @@index([eventRequirementId])
}

model Application {
  id                  String            @id @default(cuid())
  eventId             String
  companyId           String
  freelancerId        String
  eventRequirementId  String?
  status              ApplicationStatus @default(PENDING)
  message             String?
  proposedAmountCents Int?
  respondedAt         DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  event               Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventRequirement    EventRequirement? @relation(fields: [eventRequirementId], references: [id], onDelete: SetNull)
  company             CompanyProfile    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  freelancer          FreelancerProfile @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  contract            Contract?
  chatThread          ChatThread?

  @@unique([eventId, freelancerId])
  @@index([companyId])
  @@index([eventRequirementId])
  @@index([freelancerId])
}

model Contract {
  id               String            @id @default(cuid())
  eventId          String
  companyId        String
  freelancerId     String
  invitationId     String?           @unique
  applicationId    String?           @unique
  status           ContractStatus    @default(PENDING_PAYMENT)
  amountCents      Int
  platformFeeCents Int               @default(0)
  startsAt         DateTime
  endsAt           DateTime
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  event            Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  company          CompanyProfile    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  freelancer       FreelancerProfile @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  invitation       Invitation?       @relation(fields: [invitationId], references: [id])
  application      Application?      @relation(fields: [applicationId], references: [id])
  chatThread       ChatThread?
  paymentSplits    PaymentSplit[]
  reviews          Review[]
  disputes         Dispute[]
}

model ChatThread {
  id            String            @id @default(cuid())
  eventId       String
  companyId     String
  freelancerId  String
  invitationId  String?           @unique
  applicationId String?           @unique
  contractId    String?           @unique
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  event         Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  company       CompanyProfile    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  freelancer    FreelancerProfile @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  invitation    Invitation?       @relation(fields: [invitationId], references: [id])
  application   Application?      @relation(fields: [applicationId], references: [id])
  contract      Contract?         @relation(fields: [contractId], references: [id])
  messages      ChatMessage[]

  @@index([companyId])
  @@index([freelancerId])
  @@index([eventId])
}

model ChatMessage {
  id        String     @id @default(cuid())
  threadId  String
  senderId  String
  body      String
  createdAt DateTime   @default(now())
  readAt    DateTime?
  thread    ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender    User       @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@index([senderId])
}

model Availability {
  id           String            @id @default(cuid())
  freelancerId String
  startsAt     DateTime
  endsAt       DateTime
  isAvailable  Boolean           @default(false)
  reason       String?
  freelancer   FreelancerProfile @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
}

model Payment {
  id                         String         @id @default(cuid())
  companyId                  String
  eventId                    String
  gateway                    String         @default("simulated")
  gatewayPaymentId           String?
  checkoutUrl                String?
  status                     PaymentStatus  @default(PENDING)
  paymentMethod              String?
  grossAmountCents           Int
  freelancerAmountCents      Int            @default(0)
  platformFeeCents           Int            @default(0)
  companyFeeAmountCents      Int            @default(0)
  freelancerFeeAmountCents   Int            @default(0)
  gatewayFeeAmountCents      Int            @default(0)
  platformAmountCents        Int            @default(0)
  totalFreelancerAmountCents Int            @default(0)
  freelancerNetAmountCents   Int            @default(0)
  amountToChargeCompanyCents Int            @default(0)
  walletAmountCents          Int            @default(0)
  gatewayAmountCents         Int            @default(0)
  gatewayTransactionId       String?
  paidAt                     DateTime?
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt
  company                    CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  event                      Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  splits                     PaymentSplit[]

  @@index([companyId])
  @@index([eventId])
}

model PaymentSplit {
  id                       String             @id @default(cuid())
  paymentId                String
  contractId               String
  freelancerId             String
  recipientType            String             @default("FREELANCER")
  gatewayRecipientId       String?
  gatewayWalletId          String?
  amountCents              Int                @default(0)
  grossAmountCents         Int
  freelancerFeeAmountCents Int                @default(0)
  platformFeeAmountCents   Int                @default(0)
  gatewayFeeAmountCents    Int                @default(0)
  freelancerNetAmountCents Int
  splitStatus              PaymentSplitStatus @default(RESERVED)
  releaseStatus            PaymentSplitStatus @default(WAITING_RELEASE)
  releasedAt               DateTime?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  payment                  Payment            @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  contract                 Contract           @relation(fields: [contractId], references: [id], onDelete: Cascade)
  freelancer               FreelancerProfile  @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  payout                   Payout?

  @@unique([paymentId, contractId])
  @@index([contractId])
  @@index([freelancerId])
}

model Wallet {
  id           String             @id @default(cuid())
  companyId    String?            @unique
  freelancerId String?            @unique
  balanceCents Int                @default(0)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  company      CompanyProfile?    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  freelancer   FreelancerProfile? @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  payouts      Payout[]
}

model Transaction {
  id          String          @id @default(cuid())
  walletId    String
  type        TransactionType
  amountCents Int
  description String?
  createdAt   DateTime        @default(now())
  wallet      Wallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)
}

model Payout {
  id              String             @id @default(cuid())
  paymentSplitId  String?            @unique
  freelancerId    String?
  walletId        String?
  gatewayPayoutId String?
  amountCents     Int
  status          PayoutStatus       @default(PENDING)
  scheduledFor    DateTime?
  paidAt          DateTime?
  createdAt       DateTime           @default(now())
  paymentSplit    PaymentSplit?      @relation(fields: [paymentSplitId], references: [id], onDelete: Cascade)
  freelancer      FreelancerProfile? @relation(fields: [freelancerId], references: [id], onDelete: SetNull)
  wallet          Wallet?            @relation(fields: [walletId], references: [id], onDelete: Cascade)
}

model GatewayAccount {
  id                 String               @id @default(cuid())
  userId             String
  freelancerId       String?
  companyId          String?
  gateway            GatewayProvider      @default(SIMULATED)
  gatewayCustomerId  String?
  gatewayRecipientId String?
  gatewayWalletId    String?
  documentType       String?
  documentNumber     String?
  bankCode           String?
  agency             String?
  account            String?
  accountDigit       String?
  accountType        String?
  pixKey             String?
  pixKeyType         String?
  rawGatewayResponse Json?
  errorMessage       String?
  status             GatewayAccountStatus @default(PENDING)
  kycStatus          GatewayKycStatus     @default(PENDING)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  freelancer         FreelancerProfile?   @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  company            CompanyProfile?      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([gateway, freelancerId])
  @@unique([gateway, companyId])
  @@index([userId])
  @@index([freelancerId])
  @@index([companyId])
}

model PaymentWebhookEvent {
  id             String   @id @default(cuid())
  gateway        String
  eventType      String
  gatewayEventId String   @unique
  payload        Json
  processed      Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([gateway])
  @@index([processed])
}

model Review {
  id                    String             @id @default(cuid())
  contractId            String
  companyReviewerId     String?
  freelancerReviewerId  String?
  companyReviewedId     String?
  freelancerReviewedId  String?
  punctuality           Int?
  technicalQuality      Int?
  professionalPosture   Int?
  communication         Int?
  organization          Int?
  informationClarity    Int?
  payment               Int?
  professionalTreatment Int?
  overallRating         Int
  comment               String?
  createdAt             DateTime           @default(now())
  contract              Contract           @relation(fields: [contractId], references: [id], onDelete: Cascade)
  companyReviewer       CompanyProfile?    @relation("CompanyReviewsGiven", fields: [companyReviewerId], references: [id])
  freelancerReviewer    FreelancerProfile? @relation("FreelancerReviewsGiven", fields: [freelancerReviewerId], references: [id])
  companyReviewed       CompanyProfile?    @relation("CompanyReviewsReceived", fields: [companyReviewedId], references: [id])
  freelancerReviewed    FreelancerProfile? @relation("FreelancerReviewsReceived", fields: [freelancerReviewedId], references: [id])
}

model Dispute {
  id         String        @id @default(cuid())
  contractId String
  reason     String
  status     DisputeStatus @default(OPEN)
  details    String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  contract   Contract      @relation(fields: [contractId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  role      String?
  action    String
  entity    String
  entityId  String?
  ip        String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}

# Copie este arquivo para `.env` na raiz do projeto antes de rodar localmente:
# cp .env.example .env
#
# Este exemplo é seguro para desenvolvimento local. Em produção, troque todos
# os segredos, restrinja URLs públicas e desative exposições de token de debug.

# Senha das contas criadas por `pnpm prisma:seed`.
# Troque quando quiser recriar a base demo local com outra senha.
SEED_DEMO_PASSWORD="change-me-demo-password"

# Banco principal usado pela API NestJS/Prisma.
# O valor abaixo combina com o `docker-compose.yml` local.
DATABASE_URL="postgresql://nexus:nexus@localhost:5432/nexus?schema=public"

# Redis está preparado para filas/cache e integrações futuras.
# Mantenha a URL local se estiver usando `docker compose up -d`.
REDIS_URL="redis://localhost:6379"

# Segredos JWT.
# Use strings longas, aleatórias e diferentes em produção.
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"

# Tempo de vida dos tokens.
# Access token curto reduz risco; refresh token mais longo mantém a sessão.
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# URL pública da API consumida pelo app Next.js no navegador.
# Em desenvolvimento, a API roda em http://localhost:3001.
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Marca exibida na interface web. O nome técnico do monorepo continua nexus.
NEXT_PUBLIC_APP_NAME="NEXO"

# Origens aceitas pelo CORS da API. Use vírgula para múltiplas origens.
WEB_ORIGINS="http://localhost:3000"

# Rate limit simples por IP aplicado na API.
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX_REQUESTS="1000"

# Gateway de pagamento.
# Use `simulated` em desenvolvimento. `real` existe apenas como estrutura futura
# e ainda não deve ser usado sem implementar credenciais/provider real.
PAYMENT_GATEWAY_PROVIDER="simulated"
PAYMENT_GATEWAY_TRANSACTION_PREFIX="sim"
PAYMENT_GATEWAY_PLATFORM_RECIPIENT_ID="platform"
ASAAS_API_KEY=""
ASAAS_ENV="sandbox"
ASAAS_BASE_URL=""
PAGARME_SECRET_KEY=""
PAGARME_ENV="sandbox"
PAGARME_BASE_URL=""

# Regras financeiras do marketplace.
# Basis points: 100 = 1%, 800 = 8%, 10000 = 100%.
# Valores fixos são sempre em centavos.
PLATFORM_COMPANY_FEE_BASIS_POINTS="800"
PLATFORM_FREELANCER_FEE_BASIS_POINTS="0"
PLATFORM_FIXED_CONTRACT_FEE_CENTS="0"

# Taxa estimada do gateway, usada para registrar o breakdown financeiro.
# Quando houver gateway real, estes valores podem ser substituídos pelo retorno
# do próprio gateway/webhook.
PAYMENT_GATEWAY_FEE_BASIS_POINTS="0"
PAYMENT_GATEWAY_FIXED_FEE_CENTS="0"

# Automação pós-evento.
# Quando habilitada, a API envia lembrete após o fim do evento e libera repasse
# automaticamente após 1 dia útil se não houver contestação aberta.
POST_EVENT_AUTOMATION_ENABLED="true"
POST_EVENT_AUTOMATION_INTERVAL_MS="3600000"

# Storage de documentos.
# `local` salva arquivos no disco da API. Para produção real, implemente e use
# `s3` ou `r2`, com bucket, região, endpoint e credenciais do provedor.
DOCUMENT_STORAGE_PROVIDER="local"
DOCUMENT_STORAGE_LOCAL_DIR="uploads/verification-documents"
DOCUMENT_STORAGE_BUCKET=""
DOCUMENT_STORAGE_REGION=""
DOCUMENT_STORAGE_ENDPOINT=""
DOCUMENT_STORAGE_ACCESS_KEY_ID=""
DOCUMENT_STORAGE_SECRET_ACCESS_KEY=""

# E-mail.
# `local` é próprio para desenvolvimento. Com EMAIL_EXPOSE_DEV_TOKENS=true,
# tokens de recuperação podem aparecer no retorno/log para teste manual.
# Em produção, use provider real e defina EMAIL_EXPOSE_DEV_TOKENS="false".
EMAIL_PROVIDER="local"
EMAIL_EXPOSE_DEV_TOKENS="true"

# Limite máximo do corpo JSON aceito pela API.
# Mantenha compatível com uploads/base64 e payloads administrativos esperados.
JSON_BODY_LIMIT="8mb"
